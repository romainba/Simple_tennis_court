<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
  <name>Joomla module Tennis court usage</name>
  <version>1.0.0</version>
  <author>Romain Baeriswyl</author>
  <description>Module to show tennis court usage</description>
  <namespace path="src">Joomla\Module\CourtUsage</namespace>
  <files>
    <folder module="mod_court_usage">services</folder>
    <folder>src</folder>
    <folder>tmpl</folder>
  </files>
  <media destination="mod_court_usage" folder="media">
    <filename>joomla.asset.json</filename>
    <folder>js</folder>
    <folder>css</folder>
  </media>
  <config>
    <fields name="params">
    </fields>
  </config>
</extension>
